# Common defaults — board overrides in sdkconfig.defaults.esp32s3 / esp32c3
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_RCVBUF=y

# SoftAP + STA (provisioning)
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# ICC Spinel UART (overridden per target)
CONFIG_ICC_UART_BAUD=460800
CONFIG_ICC_UART_TX_GPIO=2
CONFIG_ICC_UART_RX_GPIO=4

CONFIG_WIFI_ENABLED=y
CONFIG_THREAD_HOST_ENABLED=y
CONFIG_MATTER_BRIDGE_ENABLED=y

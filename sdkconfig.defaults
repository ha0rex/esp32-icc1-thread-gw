# Standalone ESP-Matter controller + OpenThread Border Router defaults.
CONFIG_IDF_TARGET="esp32s3"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_LWIP_MAX_SOCKETS=24
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=12
CONFIG_LWIP_MULTICAST_PING=y
CONFIG_LWIP_IPV6_FORWARD=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_LWIP_NETIF_STATUS_CALLBACK=y

# Matter controller / commissioner.
CONFIG_ENABLE_CHIP_CONTROLLER_BUILD=y
CONFIG_ESP_MATTER_CONTROLLER_ENABLE=y
CONFIG_ESP_MATTER_COMMISSIONER_ENABLE=y
CONFIG_ESP_MATTER_ENABLE_MATTER_SERVER=n
CONFIG_ESP_MATTER_CONTROLLER_CUSTOM_CLUSTER_ENABLE=n
CONFIG_BUILD_CHIP_TESTS=n
CONFIG_ENABLE_OTA_REQUESTOR=n
CONFIG_WIFI_NETWORK_COMMISSIONING_DRIVER=n
CONFIG_THREAD_NETWORK_COMMISSIONING_DRIVER=n
CONFIG_CHIP_PROJECT_CONFIG="main/matter_project_config.h"
CONFIG_NUM_UDP_ENDPOINTS=16
CONFIG_CHIP_TASK_STACK_SIZE=15360

# Retail device PAA roots are placed in the paa_cert SPIFFS image.
CONFIG_SPIFFS_ATTESTATION_TRUST_STORE=y
CONFIG_TEST_ATTESTATION_TRUST_STORE=n
CONFIG_TEST_OPERATIONAL_CREDS_ISSUER=y

# BLE passes the Thread dataset to a new Matter device.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_ENABLE_ESP32_BLE_CONTROLLER=y
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=n

# Serial Matter shell.
CONFIG_ENABLE_CHIP_SHELL=y
CONFIG_ESP_MATTER_CONSOLE_TASK_STACK=4096
CONFIG_CHIP_SHELL_CMD_LINE_BUF_MAX_LENGTH=512

# OpenThread host + border router over ICC Spinel UART.
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_BORDER_ROUTER=y
CONFIG_OPENTHREAD_RADIO_SPINEL_UART=y
CONFIG_OPENTHREAD_RADIO_SPINEL_SPI=n
CONFIG_OPENTHREAD_RADIO_NATIVE=n
CONFIG_OPENTHREAD_LOG_LEVEL_DYNAMIC=n
CONFIG_OPENTHREAD_LOG_LEVEL_NOTE=y
CONFIG_OPENTHREAD_SRP_CLIENT=n
CONFIG_OPENTHREAD_DNS_CLIENT=n
CONFIG_THREAD_TASK_STACK_SIZE=8192
CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=y
CONFIG_MBEDTLS_ECJPAKE_C=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_HKDF_C=y

# OTBR owns IPv6 route handling.
CONFIG_ENABLE_ROUTE_HOOK=n
CONFIG_USE_MINIMAL_MDNS=n
CONFIG_ENABLE_EXTENDED_DISCOVERY=y
CONFIG_MDNS_MULTIPLE_INSTANCE=y
CONFIG_ENABLE_WIFI_STATION=y
CONFIG_ENABLE_WIFI_AP=n

# ICC UART (overridden per board).
CONFIG_ICC_UART_BAUD=460800
CONFIG_ICC_UART_TX_GPIO=2
CONFIG_ICC_UART_RX_GPIO=4

# Legacy portal components remain buildable but are not started by the MVP.
CONFIG_WIFI_ENABLED=n
CONFIG_THREAD_HOST_ENABLED=n
CONFIG_MATTER_BRIDGE_ENABLED=n

# HomeKit bridge. Port 80 is the portal, so HAP listens on 8118.
CONFIG_HAP_MFI_ENABLE=n
CONFIG_HAP_HTTP_SERVER_PORT=8118
CONFIG_HAP_HTTP_STACK_SIZE=16384
CONFIG_HAP_HTTP_MAX_OPEN_SOCKETS=4
CONFIG_HAP_HTTP_CONTROL_PORT=32859
CONFIG_HAP_PLATFORM_DEF_NVS_RUNTIME_PARTITION="nvs"
CONFIG_HAP_PLATFORM_DEF_NVS_FACTORY_PARTITION="factory_nvs"

# Idle reboots were a stack canary or a task stalled on the USB console.
# Keep a flash coredump, and give the busy network tasks more stack.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_CHECK_BOOT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_MDNS_MAX_SERVICES=16
CONFIG_MDNS_TASK_STACK_SIZE=8192
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=8192
# BLE discovery timeout runs on the FreeRTOS timer task and overflowed it.
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
